# The live web address, no trailing slash. Used for canonical tags, the sitemap,
# robots.txt, social share images and structured data.
NEXT_PUBLIC_SITE_URL=https://keepfitnoble.ng

# Form delivery (Join, Contact, Register Interest) by email through resend.com.
# Without these, live forms tell visitors to call or email instead.
RESEND_API_KEY=
FORMS_FROM_EMAIL=KeepFit website <forms@keepfitnoble.ng>
FORMS_TO_EMAIL=hello@keepfitnoble.ng

# Local preview only: forms show success without sending anything.
# FORMS_PREVIEW=1
